.env
*.db
*.db-shm
*.db-wal
*.db-journal
.venv/
__pycache__/
*.pyc

# Runtime state. A task's verify gate runs inside its worktree, so transcripts,
# logs and sqlite sidecars are produced there and `git add -A` at publish would
# sweep them into the branch. logs/ must stay blanket-ignored: when a task
# edit dropped it, the live event log went back under version control and the
# next merge clobbered 1.3MB of fleet history.
logs/

# Per-session handoff scratch, not a project artifact
.kimi-handoff-state.md

# graft's local graph cache when run by hand in this checkout (the fleet keeps
# its graphs outside the worktrees, under ~/worktrees/.graft/). Regenerable.
/graft/
.ignore

# Personal Claude Code state (permissions, local worktrees) — never shared
.claude/

# Reasonix fleet permissions file: embeds live API keys in allow entries
reasonix.toml
.reasonix/
.arc/
