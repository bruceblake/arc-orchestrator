[Unit]
Description=ARC captain autopilot — autonomous project manager (captain_autopilot.py)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/proxyie/arc-orchestrator
ExecStart=/home/proxyie/arc-orchestrator/.venv/bin/python -u main.py captain --autopilot
Environment=PYTHONUNBUFFERED=1
# Harness binaries: opencode's installer uses ~/.opencode/bin, npm/pip CLIs
# ~/.local/bin. The default service PATH (/usr/local/bin:/usr/bin) has
# neither, and relaunched runs died "could not spawn 'opencode'".
Environment=PATH=/home/proxyie/.opencode/bin:/home/proxyie/.local/bin:/home/proxyie/.local/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# Pause without stopping: touch logs/captain/autopilot.pause (or the
# dashboard's Pause button). Resumes it queues are detached runs, not part of
# this service: restarting the captain must never take them down with it.
KillMode=process
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
