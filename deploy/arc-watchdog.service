[Unit]
Description=ARC fleet watchdog — resume dead code runs (fleetwatch.py)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/proxyie/arc-orchestrator
ExecStart=/home/proxyie/arc-orchestrator/.venv/bin/python -u fleetwatch.py
Environment=PYTHONUNBUFFERED=1
# Harness binaries: opencode's installer uses ~/.opencode/bin, npm/pip CLIs
# ~/.local/bin. The default service PATH (/usr/local/bin:/usr/bin) has
# neither, and relaunched runs died "could not spawn 'opencode'".
Environment=PATH=/home/proxyie/.opencode/bin:/home/proxyie/.local/bin:/home/proxyie/.local/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# The runs it launches are the fleet, not part of this service: restarting or
# stopping the watchdog must never take them down with it.
KillMode=process
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
